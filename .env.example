# Copy to .env locally or set these variables in the shell that starts uvicorn.
# Never commit a real key. The API falls back to the deterministic mock provider
# when JACKBUDDY_API_KEY is empty.
CHERRYQUANT_LLM_PROVIDER=auto
JACKBUDDY_BASE_URL=https://jackbuddy.xin/v1
JACKBUDDY_API_KEY=
# Optional. If omitted, the API asks the compatible gateway for its first model.
JACKBUDDY_MODEL=
JACKBUDDY_TIMEOUT_SECONDS=45
